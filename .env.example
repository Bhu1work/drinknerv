# Shopify Storefront API — PUBLIC token, safe to ship to the browser.
# Shopify admin → Sales channels → Headless → your storefront →
# Manage API access → Storefront API → public access token.
# (Admin-created custom apps were retired on 2026-01-01; the Headless channel
# is what issues storefront tokens now.)
# Scopes: unauthenticated_read_product_listings,
#         unauthenticated_read_product_inventory,
#         unauthenticated_read_checkouts, unauthenticated_write_checkouts
VITE_SHOPIFY_STORE_DOMAIN=nerv-2782.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=
VITE_SHOPIFY_API_VERSION=2026-07

# Shopify Admin API — SECRET. Server-only: no VITE_ prefix, so Vite will never
# bundle these into client code. Used solely by the newsletter server function
# to create a customer with marketing consent.
#
# Dev Dashboard apps have no static Admin token; the server exchanges these for
# a 24-hour token via the client credentials grant. Get them from
# dev.shopify.com → your app → Settings. The app needs the write_customers
# scope and must be installed on the store.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
